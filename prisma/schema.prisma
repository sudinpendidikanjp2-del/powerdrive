datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum SyncStatus {
  PENDING
  PROCESSING
  SYNCED
  FAILED
  RETRYING
  LOCAL_ONLY
}

enum PreviewStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum DriveType {
  MY_DRIVE
  SHARED_DRIVE
}

enum ActivityAction {
  LOGIN
  LOGOUT
  USER_CREATED
  USER_UPDATED
  USER_DELETED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  GOOGLE_CONNECTED
  GOOGLE_DISCONNECTED
  DRIVE_SELECTED
  FOLDER_CREATED
  FOLDER_UPDATED
  FOLDER_DELETED
  FILE_UPLOAD_STARTED
  FILE_UPLOAD_COMPLETED
  SYNC_STARTED
  SYNC_COMPLETED
  SYNC_FAILED
  SYNC_RETRY
  FILE_DOWNLOADED
  FILE_DELETED
  FILE_TRASHED
  FILE_RESTORED
  FOLDER_TRASHED
  FOLDER_RESTORED
  TRASH_EMPTIED
  MOUNT_ITEM_IMPORTED
  SMTP_CONFIG_UPDATED
  SYSTEM_SETTING_UPDATED
  FILE_MOVED
  FILE_COPIED
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  name         String
  passwordHash String
  role         Role          @default(USER)
  avatarUrl    String?
  authProvider String?       @default("LOCAL")
  googleSub    String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  files        File[]
  activityLogs ActivityLog[]

  @@index([email])
}

model Folder {
  id                  String     @id @default(uuid())
  name                String
  description         String?
  parentId            String?
  ownerId             String?
  ownerName           String?
  permission          String?    @default("EDIT")
  targetDriveType     DriveType  @default(MY_DRIVE)
  targetDriveId       String?    // Nullable for My Drive root, or Shared Drive ID
  targetDriveName     String?    @default("My Drive")
  targetFolderPath    String     // e.g. "2026/Pendataan/KJP"
  googleDriveFolderId String?    // Resolved System-Managed Google Drive Folder ID
  syncToGoogleDrive   Boolean?   @default(true)
  isImported          Boolean?   @default(false)
  source              String?    @default("LOCAL")
  isTrashed           Boolean?   @default(false)
  trashedAt           DateTime?
  trashedBy           String?
  lastSyncedAt        DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  storageId           String?    // Associated storage mount ID

  files               File[]

  @@index([targetFolderPath])
  @@index([parentId])
  @@index([storageId])
  @@index([name])
}

model File {
  id                     String      @id @default(uuid())
  userId                 String
  folderId               String
  originalName           String
  storedName             String      // Physical filename: e.g. "uuid.bin"
  storagePath            String      // e.g. "/storage/uploads/2026/08/17/uuid.bin"
  mimeType               String
  size                   BigInt
  checksumSha256         String      // For idempotency & duplicate protection
  version                Int?        @default(1)
  versionHistory         Json?
  isTrashed              Boolean?    @default(false)
  trashedAt              DateTime?
  trashedBy              String?
  googleDriveFileId      String?     // System-Managed Google Drive File ID
  googleDriveFolderId    String?     // System-Managed Destination Folder ID
  googleDriveWebViewLink String?
  syncStatus             SyncStatus  @default(PENDING)
  previewStatus          PreviewStatus @default(PENDING)
  thumbnailPath          String?
  syncAttempts           Int         @default(0)
  lastError              String?     @db.Text
  syncedAt               DateTime?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  storageId              String?     // Associated storage mount ID
  storageKey             String?     // Storage reference key

  user                   User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  folder                 Folder      @relation(fields: [folderId], references: [id], onDelete: Restrict)
  syncJobs               SyncJob[]

  @@index([userId])
  @@index([folderId])
  @@index([syncStatus])
  @@index([checksumSha256])
  @@index([googleDriveFileId])
  @@index([storageId])
  @@index([storageKey])
  @@index([originalName])
}

model SyncJob {
  id          String      @id @default(uuid())
  fileId      String
  status      SyncStatus  @default(PENDING)
  attempts    Int         @default(0)
  maxAttempts Int         @default(5)
  lastError   String?     @db.Text
  scheduledAt DateTime    @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  file        File        @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([fileId])
  @@index([status, scheduledAt])
}

model GoogleDriveConnection {
  id                String    @id @default(uuid())
  userId            String?
  accountEmail      String
  accountName       String?
  accessToken       String    @db.Text
  refreshToken      String    @db.Text
  tokenExpiry       DateTime
  scope             String
  isConnected       Boolean   @default(true)
  selectedDriveId   String?
  selectedDriveName String?   @default("My Drive")
  selectedDriveType DriveType @default(MY_DRIVE)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model ActivityLog {
  id           String         @id @default(uuid())
  userId       String?
  action       ActivityAction
  resourceType String         // "FILE", "FOLDER", "GOOGLE_AUTH", "USER", "SYNC"
  resourceId   String?
  details      Json?
  ipAddress    String?
  userAgent    String?
  result       String         // "SUCCESS" | "FAILURE"
  errorMessage String?        @db.Text
  createdAt    DateTime       @default(now())

  user         User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model SystemSetting {
  key         String   @id
  value       String   @db.Text
  description String?
  updatedAt   DateTime @updatedAt
}

/// A shareable link to one folder or file. The id is the secret that appears in
/// the URL (?s=<id>); the optional password and email list are checked on the
/// server, so holding the URL alone is not enough when they are set.
model ShareLink {
  id            String    @id
  itemType      String    // "FOLDER" | "FILE"
  itemId        String
  permission    String    // "VIEW" | "EDIT" (EDIT allows uploads into a shared folder)
  passwordHash  String?   // bcrypt
  allowedEmails String[]  @default([])
  createdById   String
  createdAt     DateTime  @default(now())
  expiresAt     DateTime?
  revokedAt     DateTime?
  lastOpenedAt  DateTime?

  @@index([itemType, itemId])
}
