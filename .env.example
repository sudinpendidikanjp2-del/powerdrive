# =============================================================================
# GEMINI AI & PLATFORM SETTINGS
# =============================================================================
# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=""

# APP_URL: Base URL where this application is hosted (e.g. http://localhost:3000)
APP_URL="http://localhost:3000"

# Application server port
PORT=3000

# Node Environment ('development' serves the Vite dev server; Docker Compose sets 'production')
NODE_ENV="development"

# =============================================================================
# DATABASE CONFIGURATION (PostgreSQL + Prisma)
# =============================================================================
# Database parameters used by Docker Compose and internal services
DB_USER="postgres"
DB_PASSWORD="postgres_secure_password"
DB_NAME="file_upload_db"
DB_PORT=5432

# DATABASE_URL: Full PostgreSQL connection string (automatically assembled in Docker Compose).
# Optional for local development: when it is unset, the server connects to
# postgresql://DB_USER:DB_PASSWORD@localhost:DB_PORT/DB_NAME, which is the
# database `npm run db:local` starts. Uncomment to use another server:
# DATABASE_URL="postgresql://postgres:postgres_secure_password@localhost:5432/file_upload_db?schema=public"

# =============================================================================
# SECURITY & AUTHENTICATION
# =============================================================================
# SESSION_SECRET: Secret key for signing JWT tokens and user session cookies
SESSION_SECRET="your-super-secret-jwt-key-change-in-production"

# =============================================================================
# GOOGLE CLOUD OAUTH 2.0 CREDENTIALS
# =============================================================================
# Google Cloud OAuth 2.0 Client ID for Google SSO & Drive integration
GOOGLE_CLIENT_ID=""

# Google Cloud OAuth 2.0 Client Secret
GOOGLE_CLIENT_SECRET=""

# Note: Authorized Redirect URL is automatically derived from the app's hostname ({window.location.origin}/auth/callback)
# Register the app URL and callback in Google Cloud Console Credentials.

# =============================================================================
# STORAGE & FILE BUFFER SETTINGS
# =============================================================================
# STORAGE_DIR: Local storage buffer directory for holding files prior to Google Drive sync
STORAGE_DIR="./uploads"

# MAX_FILE_SIZE_MB: Maximum upload file size in megabytes (Default: 200MB)
MAX_FILE_SIZE_MB="200"

# =============================================================================
# INITIAL SEED ADMINISTRATOR ACCOUNT
# =============================================================================
ADMIN_EMAIL="admin@clouddrive.local"
ADMIN_PASSWORD="AdminPassword2026!"

# =============================================================================
# SMTP EMAIL SERVER CONFIGURATION (Optional - for Password Reset emails)
# =============================================================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_EMAIL="no-reply@clouddrive.local"
SMTP_FROM_NAME="Power Drive Cloud"


